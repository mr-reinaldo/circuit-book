---
import '../styles/global.css';
import Topbar from '../components/vue/Topbar.vue';
import Footer from '../components/vue/Footer.vue';

interface Props {
	title?: string;
	description?: string;
}

const { 
	title = "Circuit Book | IFPB",
	description = "Plataforma de Análise de Circuitos Eletrônicos com Astro.js para o Ensino de Telecomunicações no IFPB."
} = Astro.props;
---

<!doctype html>
<html lang="pt-BR">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<link rel="icon" type="image/svg+xml" href={`${(import.meta.env as any).BASE_URL}favicon.svg`} />
		<link rel="icon" href={`${(import.meta.env as any).BASE_URL}favicon.ico`} />
		<meta name="generator" content={Astro.generator} />
		
		<!-- SEO Meta Tags -->
		<title>{title}</title>
		<meta name="description" content={description} />
		<meta name="author" content="IFPB - Sistemas de Telecomunicações" />

		<!-- Security Content Security Policy (CSP) -->
		<meta http-equiv="Content-Security-Policy" content="default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net https://fonts.googleapis.com; font-src 'self' https://cdn.jsdelivr.net https://fonts.gstatic.com; img-src 'self' data: https://github.com https://avatars.githubusercontent.com; connect-src 'self' https://api.github.com;" />

		<!-- Google Fonts: Roboto and JetBrains Mono -->
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:ital,wght@0,100..800;1,100..800&family=Roboto:ital,wght@0,100;0,300;0,400;0,500;0,700;0,900;1,100;1,300;1,400;1,500;1,700;1,900&display=swap" rel="stylesheet" />
		<link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200" rel="stylesheet" />

		<!-- KaTeX Stylesheet from CDN (Allowed by CSP) -->
		<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/katex@0.16.10/dist/katex.min.css" crossorigin="anonymous" />
		
		<!-- Theme Initialization Script -->
		<script is:inline>
			const theme = (() => {
				if (typeof localStorage !== 'undefined' && localStorage.getItem('theme')) {
					return localStorage.getItem('theme');
				}
				return 'dark'; // Fallback padrão escuro, como aprovado
			})();
			if (theme === 'light') {
				document.documentElement.classList.remove('dark');
			} else {
				document.documentElement.classList.add('dark');
			}
			window.localStorage.setItem('theme', theme);
		</script>
	</head>
	<body class="bg-slate-50 dark:bg-slate-950 text-slate-800 dark:text-slate-100 min-h-screen flex flex-col font-sans selection:bg-indigo-500/30 selection:text-indigo-900 dark:selection:text-indigo-200 relative transition-colors duration-300">
		
		<Topbar client:load />
		
		<slot />
		
		<Footer client:idle />
		
		<!-- Global Toast Container -->
		<div id="toast-container" class="fixed bottom-4 right-4 z-[999] flex flex-col gap-2 pointer-events-none"></div>
	</body>
</html>

<style is:global>
	:root {
		font-family: 'Roboto', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
	}
	
	code, pre, .font-mono {
		font-family: 'JetBrains Mono', 'Fira Code', monospace;
	}

	/* Custom scrollbar for premium look */
	::-webkit-scrollbar {
		width: 8px;
		height: 8px;
	}
	::-webkit-scrollbar-track {
		background: #090d16;
	}
	::-webkit-scrollbar-thumb {
		background: #1e293b;
		border-radius: 4px;
	}
	::-webkit-scrollbar-thumb:hover {
		background: #334155;
	}
</style>
