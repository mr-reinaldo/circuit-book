---
import '../styles/global.css';
import Topbar from '../components/vue/Topbar.vue';
import Footer from '../components/vue/Footer.vue';

interface Props {
	title?: string;
	description?: string;
}

const { 
	title = "Circuit Book | IFPB",
	description = "Plataforma de Análise de Circuitos Eletrônicos com Astro.js para o Ensino de Telecomunicações no IFPB."
} = Astro.props;

const canonicalUrl = Astro.url.href;
const imageUrl = new URL(`${(import.meta.env as any).BASE_URL}favicon-512.png`, Astro.site || Astro.url).toString();
---

<!doctype html>
<html lang="pt-BR">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<link rel="icon" type="image/svg+xml" href={`${(import.meta.env as any).BASE_URL}favicon.svg`} />
		<link rel="icon" href={`${(import.meta.env as any).BASE_URL}favicon.ico`} sizes="any" />
		<link rel="apple-touch-icon" href={`${(import.meta.env as any).BASE_URL}favicon-apple-touch.png`} />
		<meta name="generator" content={Astro.generator} />
		
		<!-- SEO Meta Tags -->
		<title>{title}</title>
		<meta name="description" content={description} />
		<meta name="author" content="IFPB - Sistemas de Telecomunicações" />

		<!-- Open Graph / Facebook / WhatsApp -->
		<meta property="og:type" content="website" />
		<meta property="og:url" content={canonicalUrl} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:image" content={imageUrl} />
		<meta property="og:image:type" content="image/png" />
		<meta property="og:image:width" content="512" />
		<meta property="og:image:height" content="512" />

		<!-- Twitter -->
		<meta name="twitter:card" content="summary" />
		<meta name="twitter:url" content={canonicalUrl} />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={imageUrl} />

		<!-- Security Content Security Policy (CSP) -->
		<meta http-equiv="Content-Security-Policy" content="default-src 'self'; script-src 'self' 'unsafe-inline' https://gc.zgo.at; style-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net https://fonts.googleapis.com; font-src 'self' https://cdn.jsdelivr.net https://fonts.gstatic.com; img-src 'self' data: https://github.com https://avatars.githubusercontent.com https://mr-reinaldo.goatcounter.com; connect-src 'self' https://api.github.com https://mr-reinaldo.goatcounter.com;" />

		<!-- GoatCounter Web Analytics -->
		<script data-goatcounter="https://mr-reinaldo.goatcounter.com/count" async src="https://gc.zgo.at/count.js"></script>

		<!-- Google Fonts: Inter, Roboto and JetBrains Mono -->
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:ital,wght@0,100..800;1,100..800&family=Roboto:ital,wght@0,100;0,300;0,400;0,500;0,700;0,900;1,100;1,300;1,400;1,500;1,700;1,900&display=swap" rel="stylesheet" />
		<link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200" rel="stylesheet" />

		<!-- KaTeX Stylesheet from CDN (Allowed by CSP) -->
		<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/katex@0.16.10/dist/katex.min.css" crossorigin="anonymous" />
		
		<!-- Theme Initialization Script -->
		<script is:inline>
			const theme = (() => {
				if (typeof localStorage !== 'undefined' && localStorage.getItem('theme')) {
					return localStorage.getItem('theme');
				}
				return 'dark'; // Fallback padrão escuro, como aprovado
			})();
			if (theme === 'light') {
				document.documentElement.classList.remove('dark');
			} else {
				document.documentElement.classList.add('dark');
			}
			window.localStorage.setItem('theme', theme);
		</script>
	</head>
	<body class="min-h-screen flex flex-col font-sans relative" style="background:var(--surface-base);color:var(--text-primary);transition:background 0.3s ease,color 0.3s ease">
		
		<Topbar pathname={Astro.url.pathname} client:load />
		
		<slot />
		
		<Footer client:idle />
		
		<!-- Global Toast Container -->
		<div id="toast-container" class="fixed bottom-4 right-4 z-999 flex flex-col gap-2 pointer-events-none"></div>
	</body>
</html>

<style is:global>
	:root {
		font-family: 'Inter', 'Roboto', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
		-webkit-font-smoothing: antialiased;
	}
	
	code, pre, .font-mono {
		font-family: 'JetBrains Mono', 'Fira Code', monospace;
	}

	/* Custom scrollbar for premium look */
	::-webkit-scrollbar {
		width: 8px;
		height: 8px;
	}
	::-webkit-scrollbar-track {
		background: var(--surface-base);
	}
	::-webkit-scrollbar-thumb {
		background: var(--border-default);
		border-radius: 4px;
	}
	::-webkit-scrollbar-thumb:hover {
		background: var(--text-tertiary);
	}
</style>
